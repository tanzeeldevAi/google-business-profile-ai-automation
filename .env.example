# Copy to .env and fill in what you need. .env is gitignored.
#
# For a normal local install with the Claude CLI signed in, you need NOTHING
# in here. Google auth uses data/client_secret.json + the browser sign-in.

# ── writing, only if llm.backend is "api" ──────────────────
# Not needed when llm.backend is "claude" (the default), which uses the CLI
# you are already signed into.
ANTHROPIC_API_KEY=

# ── post images, only if images.backend is "gemini" ────────
# Google AI Studio. Free tier, no card. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── post images, only if images.host is "imagekit" ─────────
# Google Posts need a public image URL, so generated images have to be
# uploaded somewhere first. https://imagekit.io -> Developer -> API keys
IMAGEKIT_PRIVATE_KEY=
